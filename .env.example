# ════════════════════════════════════════════════════════════════
#  AI Resume Generator — конфигурация окружения
#  Скопируйте в .env и раскомментируйте нужный LLM провайдер
# ════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Для продакшена: https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./resume_generator.db

# ── Cache / Broker (опционально — только для Celery) ─────────────
# REDIS_URL=redis://localhost:6379/0

# ════════════════════════════════════════════════════════════════
#  LLM PROVIDER — выберите ОДИН вариант и раскомментируйте
#
#  Рейтинг качества генерации резюме:
#  ⭐⭐⭐⭐⭐  gemini-2.0-flash          (БЕСПЛАТНО)  ← РЕКОМЕНДУЕТСЯ
#  ⭐⭐⭐⭐½  groq / llama-3.3-70b      (БЕСПЛАТНО)
#  ⭐⭐⭐⭐½  gpt-4o-mini               (платно, ~$0.01/резюме)
#  ⭐⭐⭐⭐   ollama / qwen2.5:14b      (БЕСПЛАТНО, нужно 16GB RAM)
#  ⭐⭐⭐    ollama / qwen2.5:7b       (БЕСПЛАТНО, нужно 8GB RAM)
# ════════════════════════════════════════════════════════════════

# ── ВАРИАНТ 0: Без LLM (эвристика) ──────────────────────────────
# Мгновенно, ничего не нужно. Качество: базовое.
# Используйте только для тестирования системы.
LLM_PROVIDER=heuristic

# ════════════════════════════════════════════════════════════════
#  ⭐ РЕКОМЕНДУЕТСЯ: Google Gemini 2.0 Flash
#  БЕСПЛАТНО | Лучшее качество среди бесплатных | 1500 req/day
# ════════════════════════════════════════════════════════════════
# Как получить ключ (2 минуты):
#   1. Зайдите: https://aistudio.google.com/app/apikey
#   2. Нажмите "Get API key" → "Create API key in new project"
#   3. Скопируйте ключ (начинается с AIza...)
#
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...ваш_ключ...
# LLM_MODEL=gemini-2.0-flash
# LLM_TIMEOUT=90

# ── Groq — если нужна высокая скорость ПРИ хорошем качестве ────
# БЕСПЛАТНО | 70B параметров | 14 400 запросов/день
# Ключ: https://console.groq.com → API Keys → Create
#
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...ваш_ключ...
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT=90

# ── Ollama — локальная модель, офлайн, без ключей ───────────────
# БЕСПЛАТНО | Работает без интернета | Приватность данных
#
# УСТАНОВКА (один раз, 5–10 минут):
#   1. Скачайте: https://ollama.com/download (Windows .exe, ~100 MB)
#   2. Установите и запустите Ollama (появится в трее)
#   3. Откройте PowerShell и скачайте модель:
#
#   Для ноута с 8 GB RAM:
#     ollama pull qwen2.5:7b       # 4.7 GB
#
#   Для ноута с 16 GB RAM (рекомендуется):
#     ollama pull qwen2.5:14b      # 9.0 GB — значительно лучше качество
#
#   Для ноута с 4-6 GB RAM:
#     ollama pull qwen2.5:3b       # 2.0 GB — базовое качество
#
#   4. Проверьте: ollama list
#
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_TIMEOUT=300

# ── Kimi (Moonshot AI) ──────────────────────────────────────────
# БЕСПЛАТНО | 15 000 000 токенов/месяц | Хорошее качество
# Ключ: https://platform.moonshot.cn → API Keys
#
# LLM_PROVIDER=kimi
# LLM_API_KEY=sk-...ваш_ключ...
# LLM_MODEL=moonshot-v1-32k
# LLM_TIMEOUT=120

# ── OpenRouter — агрегатор, есть бесплатные ─────────────────────
# Ключ: https://openrouter.ai/keys
#
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...ваш_ключ...
# LLM_MODEL=google/gemini-2.0-flash-exp:free
# LLM_TIMEOUT=90

# ── OpenAI — платно, но отличное качество ───────────────────────
# ~$0.01–0.05 за резюме (gpt-4o-mini)
#
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...ваш_ключ...
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=90

# ════════════════════════════════════════════════════════════════
#  Дополнительные настройки LLM
# ════════════════════════════════════════════════════════════════

# Таймаут запроса (в секундах)
# Локальные модели на CPU работают медленно — увеличьте до 300+
LLM_TIMEOUT=180

# ── Pipeline tuning ─────────────────────────────────────────────
CRITIC_THRESHOLD=80
MAX_CRITIC_ITERATIONS=3
MAX_CONSISTENCY_RETRIES=2
PROMPT_VERSION=v1
